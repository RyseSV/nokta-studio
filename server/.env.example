# ── Copia este archivo como .env y completá los valores ──────────────────────

# Contraseña del panel admin
ADMIN_PASSWORD=nokta2025

# Secreto para las sesiones (cambiá esto por algo aleatorio largo)
SESSION_SECRET=nokta_secret_key_cambiar_esto

# Puerto del servidor
PORT=3000

# URL base del sitio (sin slash al final)
BASE_URL=http://localhost:3000

# ── Notificaciones por email (opcional, dejá vacío para desactivar) ───────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu@email.com
SMTP_PASS=tu_app_password
NOTIFY_TO=tu@email.com

# ── Webhook opcional (slack, discord, etc.) ───────────────────────────────────
# WEBHOOK_URL=https://hooks.slack.com/...
